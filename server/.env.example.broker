# Merge these into Render environment settings; never commit real values.
BROKER_DEMO_ENABLED=false
BROKER_EA_TOKEN=replace-with-long-random-secret
BROKER_ADMIN_TOKEN=replace-with-different-long-random-secret
DATABASE_URL=postgresql://user:password@host:5432/database
# Optional: PGSSLMODE=disable only for trusted local PostgreSQL.
